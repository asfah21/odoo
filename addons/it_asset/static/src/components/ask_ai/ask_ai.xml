<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="it_asset.AskAI">
        <div class="o_action_manager o_content o_it_ask_ai">
            <!-- Topbar ramping -->
            <div class="ask-topbar">
                <div class="ask-brand">
                    <div class="ask-brand-logo">
                        <i class="fa fa-magic"/>
                    </div>
                    <div>
                        <div class="ask-brand-title">Ask AI</div>
                        <div class="ask-brand-sub">GSI IT Assistant</div>
                    </div>
                </div>
                <div class="ask-topbar-right">
                    <span class="ask-retention d-none d-md-inline">
                        <i class="fa fa-clock-o me-1"/> Terhapus otomatis 10 hari
                    </span>
                    <button class="btn btn-primary btn-sm" t-on-click="() => this.newChat()">
                        <i class="fa fa-plus me-1"/> Chat Baru
                    </button>
                </div>
            </div>

            <div class="ask-layout">
                <!-- Sidebar riwayat -->
                <aside class="ask-sidebar">
                    <div class="ask-sidebar-label">Riwayat</div>
                    <div class="ask-history">
                        <t t-foreach="state.sessions" t-as="s" t-key="s.id">
                            <div t-attf-class="ask-history-item {{ s.id === state.activeSessionId ? 'active' : '' }}"
                                t-on-click="() => this.selectSession(s)">
                                <i class="fa fa-comment-o"/>
                                <span class="ask-history-title text-truncate" t-esc="s.name"/>
                                <button class="ask-history-del" title="Hapus"
                                    t-on-click="(ev) => this.deleteSession(s, ev)">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </t>
                        <t t-if="!state.sessions.length &amp;&amp; !state.loadingHistory">
                            <div class="ask-empty">Belum ada riwayat.</div>
                        </t>
                    </div>
                    <div class="ask-sidebar-footer">Riwayat lebih dari 10 hari terhapus otomatis.</div>
                </aside>

                <!-- Chat utama -->
                <main class="ask-main">
                    <div class="ask-chat-body" t-ref="chatBody">
                        <div class="ask-chat-inner">
                            <t t-if="state.loadingHistory">
                                <div class="ask-loading">
                                    <i class="fa fa-spinner fa-spin me-2"/> Memuat riwayat…
                                </div>
                            </t>

                            <!-- Sapaan ringkas + 3 saran -->
                            <t t-if="!state.loadingHistory &amp;&amp; state.messages.length &lt;= 1">
                                <div class="ask-hero">
                                    <h2>Mau cek apa hari ini?</h2>
                                    <p>Terhubung ke data live IT: stok, aset, pengguna &amp; riwayat.</p>
                                    <div class="ask-chips">
                                        <t t-foreach="state.suggestions" t-as="sg" t-key="sg.label">
                                            <button class="ask-chip" t-on-click="() => this.useSuggestion(sg.prompt)">
                                                <i t-attf-class="fa {{ sg.icon }} me-1"/>
                                                <t t-esc="sg.label"/>
                                            </button>
                                        </t>
                                    </div>
                                </div>
                            </t>

                            <!-- Pesan -->
                            <t t-foreach="state.messages" t-as="m" t-key="m.id">
                                <t t-if="m.role === 'user'">
                                    <div class="ask-msg-row ask-msg-user">
                                        <div class="ask-bubble ask-bubble-user">
                                            <div class="ask-bubble-text" t-att-data-mid="m.id"/>
                                            <div class="ask-bubble-meta"><span t-esc="m.time"/></div>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="ask-msg-row ask-msg-ai">
                                        <div class="ask-bubble ask-bubble-ai">
                                            <div class="ask-bubble-text" t-att-data-mid="m.id"/>
                                            <t t-if="m.action">
                                                <button class="btn btn-sm btn-outline-primary ask-view-action" t-on-click="() => this.openMsgAction(m)">
                                                    <i class="fa fa-external-link me-1"/> Lihat di modul
                                                </button>
                                            </t>
                                            <div class="ask-bubble-meta"><span t-esc="m.time"/></div>
                                        </div>
                                    </div>
                                </t>
                            </t>

                            <t t-if="state.isTyping">
                                <div class="ask-msg-row ask-msg-ai">
                                    <div class="ask-bubble ask-bubble-ai">
                                        <span class="typing-dots"><span/><span/><span/></span>
                                        <span class="small text-muted ms-2">AI sedang mengetik…</span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Composer -->
                    <div class="ask-composer-wrap">
                        <div class="ask-composer">
                            <textarea t-ref="chatInput"
                                class="ask-input"
                                rows="1"
                                placeholder="Tulis pertanyaan… (Enter kirim)"
                                t-att-value="state.input"
                                t-on-input="onInput"
                                t-on-keydown="onKeydown"/>
                            <button class="btn ask-send-btn"
                                t-att-disabled="!canSend"
                                t-on-click="sendMessage"
                                title="Kirim">
                                <i t-attf-class="fa {{ state.isTyping ? 'fa-spinner fa-spin' : 'fa-paper-plane' }}"/>
                            </button>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </t>
</templates>
