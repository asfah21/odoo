<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Retensi riwayat chat Ask AI: hapus otomatis sesi yang tidak aktif
             lebih dari N hari (default 10 via System Parameter). -->
        <record id="ir_cron_ask_ai_history_cleanup" model="ir.cron">
            <field name="name">Ask AI: hapus riwayat chat &gt; 10 hari</field>
            <field name="model_id" ref="model_it_asset_ask_ai_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_history()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <!-- Kamus hidup: rebuild snapshot term dari DB setiap hari. -->
        <record id="ir_cron_ask_ai_dictionary_refresh" model="ir.cron">
            <field name="name">Ask AI: refresh dictionary harian</field>
            <field name="model_id" ref="model_it_asset_ask_ai_setting"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_dictionary()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
