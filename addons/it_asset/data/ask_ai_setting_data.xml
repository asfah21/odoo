<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- One Setting row so Ask AI -> Setting opens immediately
             and Generate/Test work without clicking Create first. -->
        <record id="ask_ai_default_setting" model="it_asset.ask_ai.setting">
            <field name="name">Ask AI Setting</field>
            <field name="llm_url">http://127.0.0.1:8081</field>
            <field name="llm_model">qwen3-0.6b</field>
            <field name="llm_timeout">10</field>
            <field name="llm_json_mode">True</field>
            <field name="rephrase_enabled">False</field>
            <field name="rephrase_max_tokens">150</field>
            <field name="rephrase_temperature">0.7</field>
            <field name="history_retention_days">10</field>
            <field name="persona">alya</field>
            <field name="persona_name">Alya</field>
        </record>
    </data>
</odoo>
