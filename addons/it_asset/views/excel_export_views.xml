<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================
         TOMBOL EXPORT EXCEL UNTUK ITEM HANDOVER
         ============================================ -->
    <record id="it_asset_item_handover_form_view_excel" model="ir.ui.view">
        <field name="name">it_asset.item.handover.form.excel</field>
        <field name="model">it_asset.item.handover</field>
        <field name="inherit_id" ref="view_it_item_handover_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="export_item_handover_excel" 
                        type="object"
                        string="Export Excel"
                        class="btn-success"
                        icon="fa-file-excel-o"/>
            </header>
        </field>
    </record>

