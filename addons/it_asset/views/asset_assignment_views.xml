<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View: History -->
    <record id="view_it_asset_assignment_list" model="ir.ui.view">
        <field name="name">it.asset.assignment.list</field>
        <field name="model">it_asset.assignment</field>
        <field name="arch" type="xml">
            <list string="History" default_order="assignment_date desc">
                <field name="asset_id" string="Item / Asset"/>
                <field name="asset_tag" string="Asset Tag" optional="show"/>
                <field name="asset_type" string="Owner" widget="badge" 
                       decoration-info="asset_type == 'it'" 
                       decoration-warning="asset_type == 'operation'" 
                       optional="show"/>
                <field name="employee_id" string="User / Employee"/>
                <field name="department_id" string="Department" optional="show"/>
                <field name="assignment_date" string="Start Date"/>
                <field name="return_date" string="Return Date"/>
                <field name="state" string="Status" widget="badge" 
                       decoration-info="state == 'active'" 
                       decoration-success="state == 'returned'"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View: History -->
    <record id="view_it_asset_assignment_form" model="ir.ui.view">
        <field name="name">it.asset.assignment.form</field>
        <field name="model">it_asset.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignment History">
                <header>
                    <button name="action_return" type="object" string="Mark as Returned" 
                            class="oe_highlight" invisible="state == 'returned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,returned"/>
                </header>
                <sheet>
                    <group>
                        <group string="Asset Information">
                            <field name="asset_id"/>
                            <field name="asset_tag"/>
                            <field name="asset_type"/>
                            <field name="category_id"/>
                        </group>
                        <group string="Handover Details">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="assignment_date"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Add handover notes, conditions, or return details..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: History with Group By Asset default -->
    <record id="view_it_asset_assignment_search" model="ir.ui.view">
        <field name="name">it.asset.assignment.search</field>
        <field name="model">it_asset.assignment</field>
        <field name="arch" type="xml">
            <search string="Search History">
                <field name="asset_id" string="Asset / Item" 
                       filter_domain="['|', ('asset_id.name', 'ilike', self), ('asset_tag', 'ilike', self)]"/>
                <field name="asset_tag" string="Asset Tag"/>
                <field name="employee_id" string="Employee / User"/>
                <field name="department_id" string="Department"/>
                
                <separator/>
                <filter string="Active (In Use)" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Returned" name="filter_returned" domain="[('state', '=', 'returned')]"/>
                
                <separator/>
                <group expand="1" string="Group By">
                    <filter string="Item / Asset" name="group_by_asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Employee / User" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Month" name="group_by_month" context="{'group_by': 'assignment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: History -->
    <record id="action_it_asset_assignment" model="ir.actions.act_window">
        <field name="name">History</field>
        <field name="res_model">it_asset.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_it_asset_assignment_search"/>
        <field name="context">{'search_default_group_by_asset': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track Item Transfer History!</p>
            <p>View which employee is holding an item, past handovers, and how many times an item has changed hands.</p>
        </field>
    </record>

    <!-- Menu Item: Activity -> History -->
    <menuitem id="it_asset_menu_assignments" 
              name="History" 
              parent="it_asset_menu_management" 
              action="action_it_asset_assignment" 
              sequence="10"/>
</odoo>
