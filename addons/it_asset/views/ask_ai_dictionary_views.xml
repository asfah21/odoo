<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ask AI auto dictionary: term snapshot from the database -->
    <record id="view_it_ask_ai_term_list" model="ir.ui.view">
        <field name="name">it.ask.ai.term.list</field>
        <field name="model">it_asset.ask_ai.term</field>
        <field name="arch" type="xml">
            <list string="Ask AI Dictionary" default_order="kind asc, term asc">
                <field name="term"/>
                <field name="kind" widget="badge"
                       decoration-info="kind in ('product', 'consumable')"
                       decoration-warning="kind in ('asset', 'unit')"/>
                <field name="category" optional="show"/>
                <field name="price" optional="show"/>
                <field name="qty" optional="show"/>
                <field name="uom" optional="show"/>
                <field name="usage_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_it_ask_ai_term_form" model="ir.ui.view">
        <field name="name">it.ask.ai.term.form</field>
        <field name="model">it_asset.ask_ai.term</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="term"/>
                            <field name="normalized" readonly="1"/>
                            <field name="kind"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="price"/>
                            <field name="cost"/>
                            <field name="qty"/>
                            <field name="uom"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group string="Source">
                        <field name="source_model" readonly="1"/>
                        <field name="source_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_ask_ai_term_search" model="ir.ui.view">
        <field name="name">it.ask.ai.term.search</field>
        <field name="model">it_asset.ask_ai.term</field>
        <field name="arch" type="xml">
            <search string="Find Terms">
                <field name="term" string="Term"
                       filter_domain="['|', ('term', 'ilike', self), ('normalized', 'ilike', self)]"/>
                <field name="category"/>
                <field name="kind"/>
                <filter string="Products" name="product" domain="[('kind', '=', 'product')]"/>
                <filter string="Consumables" name="consumable" domain="[('kind', '=', 'consumable')]"/>
                <filter string="Assets" name="asset" domain="[('kind', '=', 'asset')]"/>
                <filter string="Units" name="unit" domain="[('kind', '=', 'unit')]"/>
                <filter string="Categories" name="category" domain="[('kind', '=', 'category')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="by_kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_it_ask_ai_term" model="ir.actions.act_window">
        <field name="name">Dictionary</field>
        <field name="res_model">it_asset.ask_ai.term</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Dictionary is still empty.</p>
            <p>Open <b>Ask AI -&gt; Setting</b> then click <b>Generate Dictionary</b> to read the database (products, categories, prices, stock, descriptions, assets, units, employees).</p>
        </field>
    </record>
</odoo>
