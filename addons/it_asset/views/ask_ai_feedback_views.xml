<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Antrean kurasi Ask AI (cermin intent_feedback WACS §17).
         Tanpa menu: dibuka lewat pencarian global "Ask AI Feedback".
         Kurasi mingguan: isi curated_intent / curated_not_intent lalu
         set status Terkuras; contoh nyata JANGAN disalin ke EXEMPLARS
         ask_ai_nlu.py (aturan tetap WACS: korpus ukur ≠ korpus latih). -->
    <record id="view_it_ask_ai_feedback_list" model="ir.ui.view">
        <field name="name">it.ask.ai.feedback.list</field>
        <field name="model">it_asset.ask_ai.feedback</field>
        <field name="arch" type="xml">
            <list string="Ask AI Feedback" default_order="occurrences desc">
                <field name="question"/>
                <field name="predicted_intent"/>
                <field name="confidence"/>
                <field name="capture_reason"/>
                <field name="occurrences"/>
                <field name="last_seen"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'curated'"
                       decoration-warning="status == 'new'"/>
            </list>
        </field>
    </record>

    <record id="view_it_ask_ai_feedback_form" model="ir.ui.view">
        <field name="name">it.ask.ai.feedback.form</field>
        <field name="model">it_asset.ask_ai.feedback</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,curated"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="question"/>
                            <field name="predicted_intent"/>
                            <field name="confidence"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="tool_executed"/>
                            <field name="capture_reason"/>
                            <field name="ood_reason"/>
                            <field name="occurrences"/>
                            <field name="last_seen"/>
                        </group>
                    </group>
                    <group string="Hasil Kurasi">
                        <field name="curated_intent"
                               placeholder="Intent yang benar, mis. check_stock"/>
                        <field name="curated_not_intent"
                               placeholder="Intent yang tidak boleh muncul"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_ask_ai_feedback_search" model="ir.ui.view">
        <field name="name">it.ask.ai.feedback.search</field>
        <field name="model">it_asset.ask_ai.feedback</field>
        <field name="arch" type="xml">
            <search string="Cari Feedback">
                <field name="question"/>
                <field name="predicted_intent"/>
                <filter string="Baru" name="new" domain="[('status', '=', 'new')]"/>
                <filter string="Terkurasi" name="curated" domain="[('status', '=', 'curated')]"/>
                <filter string="Unknown" name="unknown" domain="[('capture_reason', '=', 'unknown')]"/>
                <filter string="OOD" name="ood" domain="[('capture_reason', '=', 'ood_scope_filter')]"/>
                <group expand="0" string="Group By">
                    <filter string="Intent" name="by_intent" context="{'group_by': 'predicted_intent'}"/>
                    <filter string="Alasan" name="by_reason" context="{'group_by': 'capture_reason'}"/>
                    <filter string="Status" name="by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_it_ask_ai_feedback" model="ir.actions.act_window">
        <field name="name">Ask AI Feedback</field>
        <field name="res_model">it_asset.ask_ai.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada pesan tak-yakin.</p>
            <p>Antrean ini terisi otomatis dari pertanyaan yang tidak terjawab yakin.</p>
        </field>
    </record>
</odoo>
