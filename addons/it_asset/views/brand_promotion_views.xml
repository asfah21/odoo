<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hapus brand promotion di backend (footer) -->
    <record id="brand_promotion_removal" model="ir.ui.view">
        <field name="name">Remove Odoo Brand Promotion Backend</field>
        <field name="inherit_id" ref="web.brand_promotion"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'o_brand_promotion')]" position="replace">
                <div class="o_brand_promotion_removed"/>
            </xpath>
        </field>
    </record>

    <!-- Hapus "Powered by Odoo" di halaman login -->
    <record id="login_layout_poweredby_removal" model="ir.ui.view">
        <field name="name">Remove Powered by Odoo on Login</field>
        <field name="inherit_id" ref="web.login_layout"/>
        <field name="arch" type="xml">
            <xpath expr="//a[contains(@href, 'odoo.com') and contains(text(), 'Powered by')]" position="replace"/>
        </field>
    </record>
</odoo>
