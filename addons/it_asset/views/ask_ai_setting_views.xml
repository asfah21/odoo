<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ask AI Setting: auto dictionary + Qwen rephrase-only (0.6B) -->
    <record id="view_it_ask_ai_setting_form" model="ir.ui.view">
        <field name="name">it.ask.ai.setting.form</field>
        <field name="model">it_asset.ask_ai.setting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_dictionary" type="object"
                            string="Generate Dictionary" class="oe_highlight"
                            icon="fa-refresh"/>
                    <button name="action_test_qwen" type="object"
                            string="Test Qwen" icon="fa-plug"/>
                    <button name="action_open_dictionary" type="object"
                            string="View Dictionary" icon="fa-book"/>
                    <button name="action_clear_dictionary" type="object"
                            string="Clear Dictionary" icon="fa-trash"
                            confirm="Delete all dictionary terms?"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <b>Lightweight design:</b> a local dictionary that understands
                        context + typos (no API tokens, no Qwen).
                        Qwen 0.6B <b>only</b> polishes answer wording so it sounds less robotic.
                        The chatbot works fine even without Qwen.
                    </div>
                    <group string="Persona">
                        <field name="persona" widget="radio"
                               options="{'horizontal': true}"/>
                        <field name="persona_name"
                               placeholder="Empty = persona default (Alya/Raka)"/>
                    </group>
                    <group string="Persona Traits">
                        <field name="persona_summary" readonly="1" nolabel="1"
                               colspan="2"/>
                    </group>
                    <group string="Auto Dictionary (from Database)">
                        <field name="dict_count" readonly="1"/>
                        <field name="dict_last_generate" readonly="1"/>
                        <field name="dict_last_summary" readonly="1"/>
                    </group>
                    <group string="Qwen Decide — Intent (optional)">
                        <group>
                            <field name="llm_enabled"/>
                            <field name="llm_url"/>
                        </group>
                        <group>
                            <field name="llm_model"/>
                            <field name="llm_timeout"/>
                            <field name="llm_json_mode"/>
                        </group>
                    </group>
                    <group string="Qwen Rephrase 0.6B — Answer Polishing (recommended)">
                        <group>
                            <field name="rephrase_enabled"/>
                            <field name="rephrase_max_tokens"/>
                        </group>
                        <group>
                            <field name="rephrase_temperature"/>
                            <field name="qwen_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Qwen 0.6B install example (Hugging Face)">
                        <div colspan="2">
                            <p><b>Windows (PowerShell):</b> <code>scripts\install-qwen.ps1</code></p>
                            <p><b>Linux:</b> <code>bash scripts/install-qwen.sh</code></p>
                            <p>Model: <code>unsloth/Qwen3-0.6B-GGUF / Qwen3-0.6B-Q4_K_M.gguf</code> (~397 MB, CPU-only, port 8081). Indonesian alternative: <code>sail/Sailor-0.5B-Chat-gguf</code>. Details in <code>llm/README.md</code>.</p>
                        </div>
                    </group>
                    <group string="Other">
                        <field name="history_retention_days"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_ask_ai_setting_list" model="ir.ui.view">
        <field name="name">it.ask.ai.setting.list</field>
        <field name="model">it_asset.ask_ai.setting</field>
        <field name="arch" type="xml">
            <list string="Ask AI Setting">
                <field name="name"/>
                <field name="persona"/>
                <field name="dict_count"/>
                <field name="dict_last_generate"/>
                <field name="rephrase_enabled" widget="boolean_toggle"/>
                <field name="llm_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_it_ask_ai_setting" model="ir.actions.act_window">
        <field name="name">Setting</field>
        <field name="res_model">it_asset.ask_ai.setting</field>
        <field name="view_mode">form,list</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No configuration yet.</p>
            <p>Click Create, save, then click <b>Generate Dictionary</b>.</p>
        </field>
    </record>

    <!-- Pembuka singleton: menu Setting SELALU membuka THE one record
         (buat bila belum ada, buang duplikat). Tanpa ini Odoo membuka
         form kosong Create setiap kali -> kesan "tidak tersimpan". -->
    <record id="action_it_ask_ai_setting_open" model="ir.actions.server">
        <field name="name">Ask AI Setting (open)</field>
        <field name="model_id" ref="model_it_asset_ask_ai_setting"/>
        <field name="state">code</field>
        <field name="code">rec = model._get_singleton()
action = {
    "type": "ir.actions.act_window",
    "name": "Setting",
    "res_model": "it_asset.ask_ai.setting",
    "res_id": rec.id,
    "view_mode": "form",
    "views": [(env.ref("it_asset.view_it_ask_ai_setting_form").id, "form")],
    "target": "current",
}</field>
    </record>
</odoo>
