                                            </td>
                                            <td>&#160;:</td>
                                            <td style="padding: 2px;">
                                                &#160;1
                                            </td>
                                        </tr>

                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <!-- MAIN TITLE -->
                                <td style="border: 1px solid black;
                                        text-align: center;
                                        font-weight: bold;
                                        font-size: 13pt;
                                        padding: 4px;
                                        height: 28px;
                                        vertical-align: middle;">

                                    SERAH TERIMA BARANG / DOKUMEN
                                </td>
                            </tr>

                        </table>
                    </div>

                    <!-- PAGE CONTENT -->                  
                    <div class="page" style="font-family: 'Times New Roman', serif; font-size: 12pt; color: #000; padding-top: 0px; margin-top: 4px; padding-left: 50px; padding-right: 50px;">
                        
                        <!-- <div class="row mb-2"> -->
                        <div style="margin-top: 5px; margin-bottom: 8px;">
                            <div class="col-6">
                                <!-- <strong>I. Pihak Pertama</strong> -->
                                <!-- <table style="width: 100%; border-collapse: collapse; font-size: 11pt;"> -->
                                <table class="table-borderless" style="width: 100%;">
                                    <tr><td style="width: 160px; white-space: nowrap;">Yang menyerahkan</td><td>: <span t-field="o.sender_id.name"/></td></tr>
                                    <tr><td>Posisi</td><td>: <span t-field="o.sender_id.job_id.name"/></td></tr>
                                    <tr><td style="width: 160px; white-space: nowrap;">Nama Penerima</td><td>: <span t-field="o.receiver_id.name"/></td></tr>
                                    <tr><td>Posisi</td><td>: <span t-field="o.receiver_id.job_id.name"/></td></tr>
                                    <tr><td>Tanggal</td><td>: <span t-field="o.handover_date" t-options='{"widget": "date", "format": "dd MM yy"}'/></td></tr>
                                </table>
                            </div>                            
                        </div>                       

                        <table class="table table-bordered text-center" style="border-color: black;">
                            <thead style="background-color: #38b8ebff; color: black; padding: 2px;">
                                <tr>
                                    <th style="border: 1px solid black; padding: 1.1pt; text-align: center;"><strong>No</strong></th>
                                    <th style="border: 1px solid black; padding: 1.1pt; text-align: center;"><strong>Nama Barang / Dokumen</strong></th>
                                    <th style="border: 1px solid black; padding: 1.1pt; text-align: center;"><strong>Kondisi</strong></th>
                                    <th style="border: 1px solid black; padding: 1.1pt; text-align: center;"><strong>Qty</strong></th>
                                    <th style="border: 1px solid black; padding: 1.1pt; text-align: center;"><strong>Keterangan</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td style="border: 1px solid black; padding: 1.1pt;"><t t-esc="line_index + 1"/></td>
                                    <td style="border: 1px solid black; text-align: left; padding: 1.1pt;">
                                        <t t-if="line.item_type == 'asset'">
                                            <span t-field="line.asset_id.name"/>
                                            <t t-if="line.asset_id.lot_id"> (SN: <span t-field="line.asset_id.lot_id.name"/>)</t>
                                        </t>
                                        <t t-if="line.item_type == 'consumable'">
                                            <span t-field="line.consumable_id.name"/>
                                        </t>
                                    </td>
                                    <td style="border: 1px solid black; padding: 1.1pt; text-transform: capitalize;">
                                        <t t-if="line.item_type == 'asset'">
                                            <span t-field="line.asset_id.condition"/>
                                        </t>
                                        <t t-if="line.item_type == 'consumable'">
                                            Baik
                                        </t>
                                    </td>
                                    <td style="border: 1px solid black; padding: 1.1pt;">
                                        <t t-esc="line.quantity"/>
                                    </td>
                                    <td style="border: 1px solid black; padding: 1.1pt; text-align: left;">
                                        <t t-if="line.item_type == 'asset' and line.asset_id.lot_id">
                                            SN: <span t-field="line.asset_id.lot_id.name"/><br/>
                                        </t>
                                        <t t-if="line.notes">
                                            <span t-field="line.notes"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                       
                        <table style="width: 100%; border: 1px solid black; border-collapse: collapse; text-align: center; margin-top: 30px;">
                            <tr style="font-weight: bold;">
                                <td style="border: 1px solid black; width: 33%; padding: 2px;">Diserahkan Oleh,</td>
                                <td style="border: 1px solid black; width: 33%; padding: 2px;">Diterima Oleh,</td>
                                <td style="border: 1px solid black; width: 33%; padding: 2px;">Mengetahui,</td>
                            </tr>
                            <!-- Name & Signature Space -->
                            <tr>
                                <td style="border: 1px solid black; height: 100px; vertical-align: bottom; font-weight: bold; padding-bottom: 1px;">
                                    <span t-field="o.sender_id.name"/>
                                </td>
                                <td style="border: 1px solid black; height: 100px; vertical-align: bottom; font-weight: bold; padding-bottom: 1px; position: relative;">
                                    <div t-if="o.signature" style="position: absolute; bottom: 30px; left: 0; right: 0; text-align: center;">
                                        <img t-att-src="image_data_uri(o.signature)" style="max-height: 60px;"/>
                                    </div>
                                    <span t-field="o.receiver_id.name"/>
                                </td>
                                <td style="border: 1px solid black; height: 100px; vertical-align: bottom; font-weight: bold; padding-bottom: 1px;">
                                    Raden Abimanyu
                                </td>
                            </tr>
                            <!-- Job Title Row -->
                            <tr>
                                <td style="border: 1px solid black; padding: 2px;">
                                    <span t-field="o.sender_id.job_id.name"/>
                                </td>
                                <td style="border: 1px solid black; padding: 2px;">
                                    <span t-field="o.receiver_id.job_id.name"/>
                                </td>
                                <td style="border: 1px solid black; padding: 2px;">
                                    Site Manager
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
